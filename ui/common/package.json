{
  "name": "common",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^4.0.0",
    "lodash": "^4.18.1",
    "solid-js": "^2.0.3",
    "solid-styled-components": "^0.28.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.20.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "5.1.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "solid": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./embed": "./src/embed/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./icons": "./src/components/icons.tsx",
    "./styles/*": "./src/styles/*",
    "./types": "./src/types/generated/index.ts",
    "./utils": "./src/utils/index.ts"
  }
}
