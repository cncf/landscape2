{
  "name": "landscape",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^4.0.0",
    "@solid-primitives/scroll": "^3.0.0",
    "@solidjs/router": "^2.0.1",
    "apexcharts": "3.54.1",
    "bootstrap": "5.3.9",
    "common": "link:../common",
    "lodash": "^4.18.1",
    "minisearch": "^7.2.0",
    "solid-apexcharts": "^0.6.0",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "sass": "1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "5.1.1"
  },
  "description": "Landscape2 is a tool that generates interactive landscapes websites.",
  "license": "Apache-2.0"
}
