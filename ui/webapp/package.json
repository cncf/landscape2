{
  "name": "landscape",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^2.1.5",
    "@solid-primitives/scroll": "^2.1.5",
    "@solidjs/router": "^0.15.4",
    "apexcharts": "3.49.1",
    "bootstrap": "5.3.8",
    "common": "link:../common",
    "lodash": "^4.18.1",
    "minisearch": "^7.2.0",
    "solid-apexcharts": "^0.6.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.2",
    "sass": "1.99.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "5.1.0"
  },
  "description": "Landscape2 is a tool that generates interactive landscapes websites.",
  "license": "Apache-2.0"
}
