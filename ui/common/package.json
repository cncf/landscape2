{
  "name": "common",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{js,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^2.1.5",
    "lodash": "^4.18.1",
    "solid-js": "^1.9.12",
    "solid-styled-components": "^0.28.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "5.1.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "solid": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./embed": "./src/embed/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./icons": "./src/components/icons.tsx",
    "./styles/*": "./src/styles/*",
    "./types": "./src/types/generated/index.ts",
    "./utils": "./src/utils/index.ts"
  }
}
